<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- net10.0-windows required for FlaUI UIA3 COM interop via CalcAutomation.Core -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>bddgen</AssemblyName>
    <RootNamespace>BddScenarioAgent</RootNamespace>
    <!-- Run from the repo root so relative paths resolve correctly -->
    <RunWorkingDirectory>$(MSBuildThisFileDirectory)..\..</RunWorkingDirectory>
  </PropertyGroup>

  <ItemGroup>
    <!-- Run `just setup` to install latest versions via dotnet add package -->
    <PackageReference Include="Microsoft.Agents.AI" Version="*" />
    <PackageReference Include="Microsoft.Extensions.AI.Ollama" Version="*-*" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CalcAutomation.Core\CalcAutomation.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
